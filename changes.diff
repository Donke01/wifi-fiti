+/**
+ * Mirrors autoCompleteCustomerPortal directly above: once a router's setup
+ * is independently verified, request remote support on the owner's behalf
+ * automatically, using the exact same requestRemoteAccess/provisionRemoteVpn
+ * path the manual "Remote setup" dashboard button already calls.
+ *
+ * This does NOT remove the safety gate in /api/router/support-enroll that
+ * requires router_pairing_auth==='active' and router_setup_verified_at - a
+ * router still has to prove itself through the normal, verified poll path
+ * first. It only removes the requirement that a human click a button
+ * *after* that proof already exists. The owner can still revoke remote
+ * access at any time through the existing endpoint.
+ *
+ * Both functions this calls are idempotent reconcile-toward-desired-state
+ * steps (confirmed by reading allocateDesiredVpnPeerInTransaction, which
+ * short-circuits when nothing has changed) - so this is safe to call on
+ * every single sync from an already-configured router, not just the first
+ * time. It intentionally swallows its own errors: hotspot billing must
+ * keep working even if VPN provisioning hits a problem, since remote
+ * support is a secondary feature layered on top of it, not the other way
+ * round.
+ */
+function autoRequestRemoteAccess(location) {
+  if (!location || !location.router_setup_verified_at) return location;
+  try {
+    tenant_requestRemoteAccessInternal(location);
+  } catch (error) {
+    // A router that syncs again before it has acknowledged a pending
+    // revoke is routine, not a failure - it resolves itself on a later
+    // sync once the ack arrives, and can recur every cycle in between.
+    // Warn only for anything else, so this expected state does not drown
+    // out a genuine problem in production logs.
+    if (error && error.status === 409 && remoteSupportRevokeIsPending(location.id)) {
+      return locationById.get(location.id) || location;
+    }
+    console.warn(`[remote-access] auto-request failed for ${location.id}: ${error.message}`);
+  }
+  return locationById.get(location.id) || location;
+}
+
+// Split out so the try/catch above stays simple to read - this is the part
+// that can legitimately throw (e.g. a revoked-but-cleanup-pending state).
+function tenant_requestRemoteAccessInternal(location) {
+  requestRemoteAccess({ locationId: location.id, businessId: location.business_id });
+  if (config.vpnGateway && config.vpnGateway.enabled) {
+    provisionRemoteVpn({
+      locationId: location.id,
+      gatewayId: config.vpnGateway.id,
+      gatewayName: 'WiFi Fiti secure gateway',
+      managementCidr: config.vpnGateway.managementCidr,
+      actorId: 'platform:auto-onboarding',
+    });
+  }
+}
