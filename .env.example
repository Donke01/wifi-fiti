# Requires Node 22.5 or newer.

# ---- Server ----
PORT=3000
# Public HTTPS base URL of the LIVE app. Safaricom posts callbacks here. It
# must be reachable from the internet with a valid certificate. Keep this on
# cloud.wififiti.co.ke, not the public website.
PUBLIC_URL=https://cloud.wififiti.co.ke

# Public-domain split. The root domain is the WiFi Fiti Business marketing
# site; app is the dashboard, customer portals, router polling and payment
# runtime. Keep PUBLIC_URL and APP_URL the same in production. The root keeps
# temporary legacy router/API compatibility until old routers are migrated.
APP_URL=https://cloud.wififiti.co.ke
MARKETING_URL=https://wififiti.co.ke
LEGACY_HOST=wififiti.co.ke

# ---- Optional Cloudflare white-label customer portals ----
# Leave these values empty until the Worker in edge/portal-gateway is deployed
# and tested. Even when they are set, keep the switch false until the wildcard
# record and Worker route have passed their live preflight. Railway remains the
# app/router/M-Pesa origin; Cloudflare serves only tenantname.wififiti.co.ke.
PORTAL_ROOT_DOMAIN=
# Generate once with: openssl rand -hex 32
# Set the identical 64-character value as the EDGE_GATEWAY_SECRET Worker secret.
EDGE_GATEWAY_SECRET=
# This is a deliberate release switch. Set true only after Cloudflare's
# wildcard route and cloud no-Worker exclusion both pass their live check.
PORTAL_GATEWAY_ENABLED=false

# ---- Optional self-hosted WireGuard management gateway ----
# This is an outbound-only management tunnel for owner-approved routers.
# It NEVER carries customer Wi-Fi, portal, payment, or general internet traffic.
# Keep the WireGuard private key only on the VPS in /etc/wireguard; Railway
# receives the public key below plus a separate pull-agent control secret.
# Leave VPN_GATEWAY_ENABLED=false until the VPS agent is installed and tested.
VPN_GATEWAY_ENABLED=false
VPN_GATEWAY_ID=primary
VPN_GATEWAY_ENDPOINT=vpn.wififiti.co.ke
VPN_GATEWAY_PORT=51820
VPN_GATEWAY_PUBLIC_KEY=
VPN_GATEWAY_ADDRESS=10.254.0.1
VPN_GATEWAY_MANAGEMENT_CIDR=10.254.0.0/16
# Generate once with: openssl rand -hex 32
VPN_GATEWAY_CONTROL_SECRET=

# ---- Safaricom Daraja ----
# sandbox | production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill or Till number. Sandbox default shortcode is 174379.
MPESA_SHORTCODE=174379
# Lipa Na M-Pesa Online passkey from the Daraja dashboard
MPESA_PASSKEY=
# CustomerPayBillOnline for Paybill, CustomerBuyGoodsOnline for Till
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# ---- MikroTik hAP lite ----
# Reachable IP of the router from wherever this app runs.
# If the app is hosted off-site, this must be a VPN address - do NOT
# port-forward 8728 to the open internet. See README.
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=hotspot-api
MIKROTIK_PASSWORD=
# Name of the hotspot server as configured in RouterOS
MIKROTIK_HOTSPOT_SERVER=hotspot1

# ---- App ----
# SQLite file. On Railway/Render, point this at a mounted volume
# or you WILL lose payment records on redeploy.
DATABASE_PATH=./data/hotspot.db
# Shown on the portal
BRAND_NAME=WiFi Fiti
SUPPORT_PHONE=0700000000

# ---- WiFi Fiti for Business ----
# A long, private platform secret used to encrypt a business's own Daraja
# credentials before they are written to SQLite. Set this once in Railway
# and never rotate it without a credential-migration process.
# Generate with: openssl rand -base64 48
TENANT_SECRETS_KEY=

# ---- Provisioning ----
# poll = routers fetch jobs from us (nothing inbound, scales to many
#        sites, works behind any NAT). Recommended.
# api  = we connect out to one router's API (single site, same LAN).
PROVISION_MODE=poll

# Identifies this hotspot. One per physical location.
SITE_ID=kitale-1
# Shared secret the router presents. Generate with:
#   openssl rand -hex 32
SITE_TOKEN=

# Protects the platform support desk, payout-recording actions and legacy
# administrative endpoints. Leave blank to disable those admin routes.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
