# Requires Node 22.5 or newer.

# ---- Server ----
PORT=3000
# Public HTTPS base URL of the LIVE app. Safaricom posts callbacks here. It
# must be reachable from the internet with a valid certificate. Keep this on
# app.wififiti.co.ke, not the public website.
PUBLIC_URL=https://app.wififiti.co.ke

# Public-domain split. www is the WiFi Fiti Business marketing site; app is
# the dashboard, customer portals, router polling and payment runtime. Keep
# PUBLIC_URL and APP_URL the same in production. The bare domain remains a
# compatibility host until old routers and outstanding callbacks are migrated.
APP_URL=https://app.wififiti.co.ke
MARKETING_URL=https://www.wififiti.co.ke
LEGACY_HOST=wififiti.co.ke

# ---- Safaricom Daraja ----
# sandbox | production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill or Till number. Sandbox default shortcode is 174379.
MPESA_SHORTCODE=174379
# Lipa Na M-Pesa Online passkey from the Daraja dashboard
MPESA_PASSKEY=
# CustomerPayBillOnline for Paybill, CustomerBuyGoodsOnline for Till
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# ---- MikroTik hAP lite ----
# Reachable IP of the router from wherever this app runs.
# If the app is hosted off-site, this must be a VPN address - do NOT
# port-forward 8728 to the open internet. See README.
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=hotspot-api
MIKROTIK_PASSWORD=
# Name of the hotspot server as configured in RouterOS
MIKROTIK_HOTSPOT_SERVER=hotspot1

# ---- App ----
# SQLite file. On Railway/Render, point this at a mounted volume
# or you WILL lose payment records on redeploy.
DATABASE_PATH=./data/hotspot.db
# Shown on the portal
BRAND_NAME=WiFi Fiti
SUPPORT_PHONE=0700000000

# ---- WiFi Fiti for Business ----
# A long, private platform secret used to encrypt a business's own Daraja
# credentials before they are written to SQLite. Set this once in Railway
# and never rotate it without a credential-migration process.
# Generate with: openssl rand -base64 48
TENANT_SECRETS_KEY=

# ---- Provisioning ----
# poll = routers fetch jobs from us (nothing inbound, scales to many
#        sites, works behind any NAT). Recommended.
# api  = we connect out to one router's API (single site, same LAN).
PROVISION_MODE=poll

# Identifies this hotspot. One per physical location.
SITE_ID=kitale-1
# Shared secret the router presents. Generate with:
#   openssl rand -hex 32
SITE_TOKEN=

# Protects the platform support desk, payout-recording actions and legacy
# administrative endpoints. Leave blank to disable those admin routes.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
